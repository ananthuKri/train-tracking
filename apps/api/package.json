{
  "name": "@railtrack/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "RailTrack Live HTTP API and monitoring worker.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "dev:worker": "tsx watch --clear-screen=false src/worker.ts",
    "build": "prisma generate && tsup",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "prisma generate && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "openapi": "tsx scripts/write-openapi.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@railtrack/shared": "*",
    "bullmq": "^5.81.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "papaparse": "^5.5.3",
    "pg": "^8.16.0",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "rate-limit-redis": "^4.3.1",
    "swagger-ui-express": "^5.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.2",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "pino-pretty": "^13.1.1",
    "prisma": "7.10.0",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "vitest": "^3.2.4"
  }
}
