# RailTrack Live — copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=8000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/railtrack
REDIS_URL=redis://localhost:6379

# Active train-data provider: railradar | railkit | indianrailapi | mock
# "mock" runs the built-in simulator; every response is labelled DEMO DATA in the UI, emails and exports.
TRAIN_DATA_PROVIDER=railradar
RAILRADAR_API_KEY=
RAILKIT_API_KEY=
INDIAN_RAIL_API_KEY=
# Optional public Mapbox token (pk.*). Leave empty to use OpenStreetMap tiles.
MAPBOX_TOKEN=

# Web scraping first, API last. Sources are tried in this order, each up to SCRAPER_MAX_ATTEMPTS times,
# then TRAIN_DATA_PROVIDER (the API) is used. A site that keeps failing is skipped for SCRAPER_COOLDOWN_MINUTES.
# Options: railyatri, whereismytrain. Leave empty for API only. Ignored when TRAIN_DATA_PROVIDER=mock.
SCRAPER_PROVIDERS=railyatri,whereismytrain
SCRAPER_MAX_ATTEMPTS=2
SCRAPER_COOLDOWN_MINUTES=5

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=RailTrack Live
SMTP_FROM_EMAIL=
APP_BASE_URL=http://localhost:5173
# At least 32 random characters, e.g. `openssl rand -hex 32`. Used to hash public share-link tokens.
REPORT_LINK_SECRET=

# ---- Additional settings -------------------------------------------------------------
# Signs session cookies. At least 32 random characters; required in production.
SESSION_SECRET=
# Comma-separated emails that get the admin role when they register (provider usage page).
ADMIN_EMAILS=
# Days a shared report link stays valid.
SHARE_LINK_TTL_DAYS=7
# Number of reverse proxies in front of the API (sets Express "trust proxy" for correct client IPs).
TRUST_PROXY=
# Provider base-URL overrides (defaults shown).
# RAILRADAR_BASE_URL=https://api.railradar.in/v1
# RAILKIT_BASE_URL=https://api.railkit.in
# INDIAN_RAIL_API_BASE_URL=https://indianrailapi.com/api/v2
PROVIDER_TIMEOUT_MS=10000
# Requests per minute allowed to the active provider. Defaults are free-tier safe (RailRadar Sandbox: 10/min);
# raise to your plan's burst limit (e.g. RailRadar Developer 30, Growth 60, Scale 120).
PROVIDER_MAX_PER_MINUTE=
# Demo simulator only: probability (0–1) of a simulated provider failure, to exercise "last verified" fallbacks.
MOCK_FAILURE_RATE=0
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
